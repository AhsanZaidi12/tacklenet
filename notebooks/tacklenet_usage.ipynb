## 3. Verify the frozen split

The frozen benchmark uses the seed-42 stratified clip-level split with
515 training, 111 validation, and 111 test clips. A practice session can
appear in multiple partitions. Use `Session_ID` for separate
session-disjoint analyses.

The notebook compares its regenerated assignments with `splits_frozen.csv`
when that file is available. If the CSV is absent, it reconstructs the
assignments in memory from the annotations. It preserves the annotation
row order when applying the frozen split procedure.
SPLIT_COLUMNS = ["clip_id", "clip_filename", "satt3_risk_binary", "split"]
EXPECTED_SPLITS = {"train": 515, "val": 111, "test": 111}


def recreate_frozen_split(annotations: pd.DataFrame, seed: int = 42) -> pd.DataFrame:
    """Apply the frozen clip-level split procedure to the annotation rows."""
    source = annotations[SPLIT_COLUMNS[:-1]].copy()
    train, remaining = train_test_split(
        source, test_size=0.30, stratify=source["satt3_risk_binary"], random_state=seed,
    )
    validation, test = train_test_split(
        remaining, test_size=0.50, stratify=remaining["satt3_risk_binary"], random_state=seed,
    )
    split_rows = pd.concat(
        [train.assign(split="train"), validation.assign(split="val"), test.assign(split="test")],
        ignore_index=True,
    )
    return split_rows[SPLIT_COLUMNS].sort_values("clip_id").reset_index(drop=True)


recreated = recreate_frozen_split(ann)
if SPLITS_PATH is None:
    splits = recreated
    print("Recreated the frozen assignments in memory.")
else:
    splits = pd.read_csv(SPLITS_PATH)
    missing_columns = set(SPLIT_COLUMNS) - set(splits.columns)
    if missing_columns:
        raise ValueError(f"Missing columns in splits_frozen.csv: {sorted(missing_columns)}")
    splits = splits[SPLIT_COLUMNS].sort_values("clip_id").reset_index(drop=True)
    pd.testing.assert_frame_equal(splits, recreated)
    print("All assignments match splits_frozen.csv.")

assert splits["split"].value_counts().to_dict() == EXPECTED_SPLITS
merged = ann.merge(splits[["clip_id", "split"]], on="clip_id", validate="one_to_one")
assert len(merged) == len(ann)
summary = (
    merged.groupby("split")["satt3_risk_binary"]
    .agg(clips="size", risky="sum", safe=lambda values: (values == 0).sum())
    .reindex(["train", "val", "test"])
)
display(summary)
## 4. Inspect local clips

The preview uses one local clip per SATT3 grade when available. Set
`PREVIEW_CLIP` in Section 1 to choose the contact-window example,
or `CHECK_ALL_VIDEOS = True` to validate the range of each local
clip's contact annotation. Video decoding follows the stored frame order.
Preview frames are resized for display.
def inspect_video(path: Path, contact: int) -> dict:
    """Count decoded frames and check that the contact annotation is in range."""
    cap = cv2.VideoCapture(str(path))
    try:
        if not cap.isOpened():
            raise ValueError(f"OpenCV could not open {path.name}.")
        fps = cap.get(cv2.CAP_PROP_FPS)
        width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        n_frames = 0
        while cap.grab():
            n_frames += 1
    finally:
        cap.release()
    if not 0 <= contact < n_frames:
        raise ValueError(f"{path.name}: contact frame {contact} is outside {n_frames} frames.")
    return {
        "clip_filename": path.name,
        "decoded_frames": n_frames,
        "fps": round(fps, 2),
        "resolution": f"{width}×{height}",
        "fpoc_frame": contact,
    }


def read_frames(path: Path, indices, max_side: int = 640) -> dict:
    """Read the requested RGB frames without seeking."""
    wanted = {int(index) for index in indices}
    if not wanted:
        return {}
    cap = cv2.VideoCapture(str(path))
    frames = {}
    try:
        if not cap.isOpened():
            raise ValueError(f"OpenCV could not open {path.name}.")
        for index in range(max(wanted) + 1):
            if not cap.grab():
                break
            if index not in wanted:
                continue
            ok, bgr = cap.retrieve()
            if ok:
                rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
                height, width = rgb.shape[:2]
                if max(height, width) > max_side:
                    scale = max_side / max(height, width)
                    size = (max(1, round(width * scale)), max(1, round(height * scale)))
                    rgb = cv2.resize(rgb, size, interpolation=cv2.INTER_AREA)
                frames[index] = rgb
    finally:
        cap.release()
    missing = wanted - set(frames)
    if missing:
        raise ValueError(f"{path.name}: could not decode frames {sorted(missing)}.")
    return frames


def show_frame_grid(frames, titles, suptitle: str = "") -> None:
    """Display the selected frames side by side."""
    fig, axes = plt.subplots(1, len(frames), figsize=(2.2 * len(frames), 2.4))
    for axis, frame, title in zip(np.atleast_1d(axes), frames, titles):
        axis.imshow(frame)
        axis.set_title(title, fontsize=9)
        axis.axis("off")
    fig.suptitle(suptitle)
    fig.tight_layout()
    plt.show()
local = merged.loc[merged["clip_filename"].isin(available_videos)]
local = local.sort_values(["satt3_score", "clip_id"]).set_index("clip_filename")
unmatched = len(available_videos) - len(local)
if unmatched:
    print(f"Skipping {unmatched} MP4s with no matching annotation filename.")

if PREVIEW_CLIP is not None and PREVIEW_CLIP not in local.index:
    raise ValueError("PREVIEW_CLIP must match a local MP4 and its annotation filename.")

preview = local.drop_duplicates("satt3_score")
if PREVIEW_CLIP is not None:
    selected_grade = local.loc[PREVIEW_CLIP, "satt3_score"]
    preview = pd.concat([
        local.loc[[PREVIEW_CLIP]],
        preview.loc[preview["satt3_score"] != selected_grade],
    ])

video_info = {}
if local.empty:
    print("Add annotated MP4s or set VIDEO_DIR to see the video examples.")
else:
    check_rows = local if CHECK_ALL_VIDEOS else preview
    for filename, row in check_rows.iterrows():
        video_info[filename] = inspect_video(VIDEOS_DIR / filename, int(row["fpoc_frame"]))
    display(pd.DataFrame(video_info.values()).set_index("clip_filename"))
    display(preview[["Session_ID", "split", "fpoc_frame", *SATT_COLS, "satt3_risk_binary"]])
## 5. Extract the 32-frame contact window

The window includes 23 frames before contact, the contact frame, and
eight frames after contact. Contact stays at zero-based position 23.
Indices beyond the clip's boundaries repeat the nearest boundary frame.
def fpoc_window_indices(fpoc_frame: int, n_frames: int, pre: int = 23, post: int = 8) -> np.ndarray:
    """Clip-frame indices of the FPOC window, clamped to [0, n_frames - 1]."""
    if n_frames <= 0:
        raise ValueError("Empty clip: no decoded frames.")
    if pre < 0 or post < 0:
        raise ValueError("pre and post must be non-negative.")
    if not 0 <= fpoc_frame < n_frames:
        raise ValueError(f"fpoc_frame={fpoc_frame} is outside the valid range [0, {n_frames - 1}].")

    idx = np.clip(np.arange(fpoc_frame - pre, fpoc_frame + post + 1), 0, n_frames - 1)
    assert len(idx) == pre + 1 + post
    assert idx[pre] == fpoc_frame, f"FPOC frame is not at window index {pre}."
    return idx


def extract_fpoc_window(clip: np.ndarray, fpoc_frame: int, pre: int = 23, post: int = 8) -> np.ndarray:
    """Reference implementation for a clip already decoded into memory, shape (T, H, W, C).

    Returns a (pre + 1 + post, H, W, C) array with the FPOC frame at index `pre`.
    """
    if clip is None or len(clip) == 0:
        raise ValueError("Empty clip: no decoded frames.")
    return clip[fpoc_window_indices(fpoc_frame, len(clip), pre, post)]


def load_fpoc_window(path: Path, fpoc_frame: int, n_frames: int,
                     pre: int = 23, post: int = 8, max_side: int = 640) -> np.ndarray:
    """Same window as extract_fpoc_window, decoding only the frames the window needs."""
    idx = fpoc_window_indices(fpoc_frame, n_frames, pre, post)
    frames = read_frames(path, np.unique(idx), max_side=max_side)
    return np.stack([frames[int(i)] for i in idx])
if not preview.empty:
    filename = preview.index[0]
    example = video_info[filename]
    contact = example["fpoc_frame"]
    n_frames = example["decoded_frames"]
    indices = fpoc_window_indices(contact, n_frames)
    window = load_fpoc_window(VIDEOS_DIR / filename, contact, n_frames)
    print(f"{filename}: first contact at frame {contact}, window shape {window.shape}.")

    full_indices = np.linspace(0, n_frames - 1, 8, dtype=int)
    full_frames = read_frames(VIDEOS_DIR / filename, full_indices)
    show_frame_grid(
        [full_frames[index] for index in full_indices],
        [f"Frame {index}" for index in full_indices],
        f"{filename} across the clip",
    )

    positions = (0, 8, 16, 22, 23, 24, 31)
    titles = [
        f"Window {position}\nFrame {indices[position]}"
        + (" (contact)" if position == 23 else "")
        for position in positions
    ]
    show_frame_grid(
        [window[position] for position in positions],
        titles,
        f"{filename}: selected frames from the 32-frame contact window",
    )
## 6. Compare contact frames across grades

Each row shows a selected local clip around its annotated contact frame.
The fourth column shows first contact. A video subset is useful for
inspection. Benchmark evaluation uses the full designated test partition.
if not preview.empty:
    offsets = (-23, -12, -4, 0, 8)
    fig, axes = plt.subplots(
        len(preview), len(offsets),
        figsize=(3 * len(offsets), 2.2 * len(preview)), squeeze=False,
    )
    for row_index, (filename, row) in enumerate(preview.iterrows()):
        contact = int(row["fpoc_frame"])
        n_frames = video_info[filename]["decoded_frames"]
        indices = np.clip(contact + np.array(offsets), 0, n_frames - 1)
        frames = read_frames(VIDEOS_DIR / filename, indices, max_side=480)
        for axis, offset, index in zip(axes[row_index], offsets, indices):
            axis.imshow(frames[index])
            axis.set_title("Contact" if offset == 0 else f"{offset:+d} frames", fontsize=8)
            axis.set_xticks([])
            axis.set_yticks([])
        axes[row_index, 0].set_ylabel(f"{filename}\nSATT3 grade {row['satt3_score']}")
    fig.tight_layout()
    plt.show()
